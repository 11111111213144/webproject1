<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="../css/style.css">
</head>

<body>
    <table>
        <thead>
            <tr>
                <th>ลำดับ</th>
                <th>รหัสผู้ใช้</th>
                <th>ชื่อ</th>
                <th>นามสกุล</th>
                <th>ชื่อผู้ใช้</th>
                <th>รหัสผ่าน</th>
                <th>อีเมล</th>
                <th>เบอร์โทรศัพท์</th>
                <th>บทบาท</th>
            </tr>
        </thead>
        <tbody>
            <% user.forEach((user, index)=> { %>
                <tr>
                    <td>
                        <%= index + 1 %>
                    </td>
                    <td>
                        <%= user.userId %>
                    </td>
                    <td>
                        <%= user.Fname %>
                    </td>
                    <td>
                        <%= user.Lname %>
                    </td>
                    <td>
                        <%= user.userName %>
                    </td>
                    <td>
                        <%= user.userPass %>
                    </td>
                    <td>
                        <%= user.email %>
                    </td>
                    <td>
                        <%= user.phone %>
                    </td>
                    <td>
                        <%= user.role %>
                    </td>
                </tr>
                <% }) %>
        </tbody>
    </table>
</body>

</html>