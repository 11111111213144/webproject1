<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login</title>
    <link rel="stylesheet" href="../css/new_style.css">
    <script>
        <% if (locals.msg) { %>
            alert("<%= msg %>");
            <% } %>
    </script>
</head>

<body>
    <main class="form-register">
        <header class="register-header">
            <h1>สมัครสมาชิก</h1>
        </header>

        <form action="/member/register" method="post">
            <div class="form-group">
                <label for="username" class="text-label">ชื่อผู้ใช้</label>
                <br>
                <input type="text" name="username" class="input-box" required value="<%= locals?.username %>">
            </div>

            <div class="form-group">
                <label for="fullname" class="text-label">ชื่อจริง</label>
                <br>
                <input type="" name="fullname" class="input-box" required value="<%= locals?.fullname %>">
            </div>

            <div class="form-group">
                <label for="lastname" class="text-label">นามสกุล</label>
                <br>
                <input type="text" name="lastname" class="input-box" required value="<%= locals?.lastname %>">
            </div>

            <div class="form-group">
                <label for="email" class="text-label">อีเมล</label>
                <br>
                <input type="email" name="email" class="input-box" required value="<%= locals?.email %>">
            </div>

            <div class="form-group">
                <label for="" class="text-label">เบอร์โทรศัพท์</label>
                <br>
                <input type="number" name="phone" class="input-box" required value="<%= locals?.phone %>">
            </div>

            <div class="form-group">
                <label for="password" class="text-label">รหัสผ่าน</label>
                <br>
                <input type="password" name="password" class="input-box" required value="<%= locals?.password %>">
            </div>

            <div class="form-group">
                <label for="role" class="text-label">บทบาท</label>
                <br>
                <select name="role" value="<%= locals?.role %>">
                    <option value="user">ผู้ใช้</option>
                    <option value="admin">ผู้ดูแลระบบ</option>
                </select>
            </div>




            <button type="submit" class="confirm-btn">สมัครสมาชิก</button>

        </form>

        <footer class="login-link">
            มีบัญชีผู้ใช้แล้ว? <a href="/member/login">เข้าสู่ระบบที่นี่</a>
        </footer>
    </main>
</body>

</html>