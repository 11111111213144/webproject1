<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login</title>
    <link rel="stylesheet" href="../css/new_style.css">
    <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500&display=swap" rel="stylesheet">
</head> 

<body>
    <main class="form-register">
        <header class="register-header">
            <h1>เข้าสู่ระบบ</h1>
        </header>
        
        <form action="/member/verify" method="post" >
            <% if (locals.msg) { %>
                <div class="alert alert-danger">
                    <%= msg %>
                </div>
            <% } %>
            
            <% if (typeof registerStatus !=='undefined' && registerStatus) { %>
                <div class="alert alert-success">
                    <%= registerStatus %>
                </div>
            <% } %>
            
            <div class="form-group" clas>
                <label for="username" class="text-label">ชื่อผู้ใช้</label>
                <br>
                <input type="text" id="username" name="username" class="input-box"
                value="<%= locals?.username %>"  required>
            </div>
            
            <div class="form-group">
                <label for="password" class="text-label">รหัสผ่าน</label>
                <input type="password" id="password" name="password" class="input-box"
                value="<%= locals?.password %>"  required>
            </div>

            <button type="submit" class="confirm-btn">เข้าสู่ระบบ</button>
        </form>
        
        <footer class="login-link">
            <p>ยังไม่มีบัญชีผู้ใช้? <a href="/member/register">สมัครสมาชิกที่นี่</a></p>
        </footer>
    </main>
</body>
</html>