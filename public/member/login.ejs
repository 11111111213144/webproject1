<!DOCTYPE html>
<html lang="th">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login Page</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="../css/style.css">

</head>

<body>

    <div class="login-container">
        <div class="card custom-card">
            <form action="/member/verify" method="post">
                <% if (locals.msg) { %>
                    <div class="alert alert-danger" role="alert">
                        <%= msg %>
                    </div>
                    <% } %>
                        <% if (typeof registerStatus !=='undefined' && registerStatus) { %>
                            <div class="alert alert-success" role="alert">
                                <%= registerStatus %>
                            </div>
                            <% } %>
                                <div class="mb-custom">
                                    <label for="username" class="form-label">ชื่อผู้ใช้งาน</label>
                                    <input type="text" class="form-control" id="username" value="<%=locals?.username %>"
                                        placeholder="Enter your username" name="username" required>
                                </div>

                                <div class="mb-custom">
                                    <label for="password" class="form-label">รหัสผ่าน</label>
                                    <input type="password" class="form-control" id="password"
                                        value="<%=locals?.password %>" placeholder="Enter your password" name="password"
                                        required>
                                </div>

                                <div class="text-center mt-4">
                                    <button type="submit" class="btn btn-login">เข้าสู่ระบบ</button>
                                </div>
                                <div class="text-center mt-4">
                                    <button type="button" class="btn btn-login"
                                        onclick="location.href='/member/register'">สมัครสมาชิก</button>
                                </div>
            </form>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>