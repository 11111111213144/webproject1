@import url('https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500&display=swap');
@import url('https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200');
@import url('https://fonts.googleapis.com/icon?family=Material+Icons');

.material-icons {
  font-family: 'Material Icons';
  font-style: normal;
  font-weight: normal;
  font-size: 24px; /* adjust size as needed */
  line-height: 1;
  display: inline-block;
  vertical-align: middle;
}


* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Kanit', sans-serif;
}

body.auth-page {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 100vh;
    background-color: #c5fbee;
}

.form-register {
    width:500px;
    background: #ffffff;
    color: #0d7d6f;
    border-radius: 20px;
    border: solid 2px #4dd0c1;
    box-shadow: 0 4px 6px rgba(77, 208, 193, 0.1);
}

.form-register h1{
    text-align: center;
    font-size: 36px;
    color: #000000;
}

.form-register .input-box {
    width: 100%;
    padding: 10px;
    border-radius: 20px;
    border: solid 2px #a8e6cf;
    display: block;
    margin: 0 auto;
    background-color: #f0fdf4;
    color: #064e3b;
}

.form-register .form-group {
    margin: 30px;
}

.form-group .text-label {
    font-size: 16px;
    margin: 0;
}

.confirm-btn{
    width: 40%;
    font-size: 16px;
    display: block;
    padding: 13px;
    margin: 0px auto;
    margin-bottom: 20px;
    background: #10b981;
    color: #ffffff;
    border-radius: 20px;
    border: solid 2px #0d7d6f;
    cursor: pointer;
}

.login-link{
    text-align: center;
    margin-bottom: 20px;
    color: #065f46;
}

.login-link a {
    color: #10b981;
    text-decoration: none;
}

.login-link a:hover {
    color: #0d7d6f;
    text-decoration: underline;
}

/* NAVBAR CSS */
body{
    margin: 0px;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Kanit', sans-serif;
    background-color: #f0fdf4;
}

.navbar{
    background: linear-gradient(135deg, #065f46 0%, #10b981 100%);
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    position: sticky;
    top: 0;
    z-index: 1000;
    backdrop-filter: blur(10px);
    border-bottom: 2px solid #059669;
}

.navbar-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1rem;
}

.navbar ul{
    list-style-type: none;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
}

.navbar li {
    position: relative;
}

.navbar a{
    text-decoration: none;
    padding: 1rem 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: #ffffff;
    font-weight: 500;
    font-size: 16px;
    border-radius: 8px;
    position: relative;
    overflow: hidden;
}







/* Mobile responsive */
@media (max-width: 768px) {
    .navbar ul {
        flex-direction: column;
        gap: 0.25rem;
    }
    
    .navbar a {
        padding: 0.75rem 1rem;
        font-size: 14px;
    }
}


/* item page */
.filter-box {
    display: flex;
    justify-content: left;
    align-items: center;
    background-color: #a8e6cf;
    padding: 15px;
    border-radius: 5px 5px 0 0;
    gap: 10px;
}

.filter-box label {
    display: grid;
    align-items: center;
    gap: 8px;
    color: #000000;
}

.filter-box input {
    padding: 8px 12px;
    border: 1px solid #50cf89;
    border-radius: 4px;
}


/* table  */

.table-box {
    border-collapse: collapse;
    font-size: 0.9em;
    min-width: 400px;
    border-radius: 5px 5px 0 0;
}

.table-box thead tr{
    background-color: #50cf89;
    color: #000000;
    text-align: center;
    font-weight: bold;
    border-bottom: #000000 2px solid;
}

.table-box th, .table-box td {
    padding: 12px 15px;
}

.table-box tbody tr {
    text-align: center;
    border-bottom: 1px solid #dddddd;
    text-align: center;
}

.table-box tbody tr:nth-of-type(odd) {
    background-color: #f3f3f3;
}

.table-box tbody tr:last-of-type {
    border-bottom: 2px solid #50cf89;
}

main{
    display: grid;
    padding: 50px;
}





/* btn */
.edit-btn{


}

/* edit-item Page*/
.item-edit-container{
    display: flex;
    justify-content: center;
    align-items: center;
}

/* homepage */
.main-card{
    padding: 2rem;
    display: grid;
    grid-template-columns: 1fr 1fr 1fr 1fr;
    justify-content: center;
    align-items: center;
    gap: 6rem;
    margin: 0 auto;
}

.card{
    display: flex;
    flex-direction: column;
    justify-content: space-around;
    align-items: center;
    padding: 2rem 1.5rem;
    border: none;
    border-radius: 20px;
    text-align: center;
    background: linear-gradient(135deg, #ffffff 0%, #f8fafc 100%);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
    min-width: 200px;
    min-height: 150px;
}

.card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 5px;
    background: linear-gradient(90deg, #f59e0b, #ef4444, #3b82f6, #10b981);
    opacity: 0;
    transition: opacity 0.3s ease;
}

.card:hover::before {
    opacity: 1;
}

.card:hover {
    transform: translateY(-8px) scale(1.02);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
}

.card:nth-child(1) {
    background: linear-gradient(135deg, #fef2f2 0%, #fee2e2 100%);
    border: 2px solid #fecaca;
}

.card:nth-child(1):hover {
    border-color: #ef4444;
    box-shadow: 0 20px 40px rgba(239, 68, 68, 0.2);
}

.card:nth-child(2) {
    background: linear-gradient(135deg, #fefce8 0%, #fef3c7 100%);
    border: 2px solid #fed7aa;
}

.card:nth-child(2):hover {
    border-color: #f59e0b;
    box-shadow: 0 20px 40px rgba(245, 158, 11, 0.2);
}

.card:nth-child(3) {
    background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%);
    border: 2px solid #bbf7d0;
}

.card:nth-child(3):hover {
    border-color: #10b981;
    box-shadow: 0 20px 40px rgba(16, 185, 129, 0.2);
}

.card:nth-child(4) {
    background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%);
    border: 2px solid #bfdbfe;
}

.card:nth-child(4):hover {
    border-color: #3b82f6;
    box-shadow: 0 20px 40px rgba(59, 130, 246, 0.2);
}

.card-inner{
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 1rem;
}

.card-inner > p{
    font-size: 18px;
    font-weight: 600;
    color: #475569;
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.card-inner > span{
    font-size: 42px;
    font-weight: 700;
    margin: 0;
}

/* Card icon styling */
.card:nth-child(1) .card-inner > span {
    color: #dc2626;
}

.card:nth-child(2) .card-inner > span {
    color: #d97706;
}

.card:nth-child(3) .card-inner > span {
    color: #059669;
}

.card:nth-child(4) .card-inner > span {
    color: #2563eb;
}

.value{
    font-size: 20px;
}


/* homepage fix box */
.main-box{
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    margin-top: 3rem;
    padding: 0 2rem;
}

.main-box > .box{
    background: linear-gradient(135deg, #ffffff 0%, #f8fafc 100%);
    border-radius: 16px;
    padding: 2rem;
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.08);
    border: 1px solid #e2e8f0;
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
}

.main-box > .box::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(90deg, #10b981, #3b82f6);
    opacity: 0;
    transition: opacity 0.3s ease;
}

.main-box > .box:hover::before {
    opacity: 1;
}

.main-box > .box:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 35px rgba(0, 0, 0, 0.12);
    border-color: #cbd5e1;
}

.main-box > .box h1 {
    color: #1e293b;
    font-size: 1.25rem;
    font-weight: 600;
    margin-bottom: 1.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 2px solid #f1f5f9;
    display: flex;
    align-items: center;
    gap: 0.5rem;
}


/*  dash board table */
.main-box > .box:first-child h1::before {
    content: '⏳';
}

.main-box > .box:last-child h1::before {
    content: '✅';
}

.main-box > .box .table-box {
    width: 100%;
    margin: 0;
    border-radius: 8px;
    overflow: hidden;
    font-size: 0.875rem;
}

.main-box > .box .table-box thead tr {
    background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
    border-bottom: 2px solid #e2e8f0;
}

.main-box > .box .table-box th {
    color: #475569;
    font-weight: 600;
    text-transform: uppercase;
    font-size: 0.75rem;
    letter-spacing: 0.5px;
    padding: 1rem 0.75rem;
}

.main-box > .box .table-box tbody tr {
    transition: background-color 0.2s ease;
}

.main-box > .box .table-box tbody tr:hover {
    background-color: #f8fafc;
}

.main-box > .box .table-box tbody tr:nth-of-type(odd) {
    background-color: #fcfcfc;
}

.main-box > .box .table-box td {
    padding: 0.875rem 0.75rem;
    color: #64748b;
    font-weight: 500;
}

.main-box > .box .table-box td:first-child {
    color: #1e293b;
    font-weight: 600;
}



/* i dont know  */
html {
    height: 100%;
}

body {
    margin: 0;
    background-color: #f4f6f9;
    font-family: 'Kanit', sans-serif;
    height: 100%;
    display: flex;
    flex-direction: column;
}

.home-link {
    padding: 20px;
    font-size: 1.2rem;
    color: #333;
    text-decoration: none;
    position: absolute;
    top: 0;
    left: 0;
}

.login-container {
    flex-grow: 1;
    display: flex;
    justify-content: center;
    align-items: center;
}

.custom-card {
    background-color: #c0fce8;
    width: 100%;
    max-width: 400px;
    border-radius: 30px;
    padding: 40px;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
    border: none;
}

.form-label {
    font-weight: 500;
    color: #333;
    margin-bottom: 5px;
}

.form-control {
    border-radius: 15px;
    border: none;
    padding: 10px 15px;
}

.btn-login {
    background-color: #00dca0;
    color: white;
    border: none;
    border-radius: 50px;
    padding: 10px 40px;
    font-size: 1rem;
    transition: all 0.3s;
}

.btn-login:hover {
    background-color: #00b886;
}

.mb-custom {
    margin-bottom: 25px;
}

.bg-custom-mint {
    background-color: #1DE9B6;
}

.navbar-brand, .nav-link {
    color: #333 !important;
    /* สีตัวอักษรเข้ม */
    font-weight: 500;
}

/* ปรับระยะห่างของเมนูตรงกลางให้ดูสมดุล */
.center-menu .nav-item {
    padding-left: 20px;
    padding-right: 20px;
}

/* ส่วนหัวข้อตรงกลางหน้า */
.welcome-text {
    margin-top: 50px;
    font-size: 2rem;
    color: #000;
}

.bth-logout {
    color: red !important;
    border: none;
    border-radius: 50px;
    padding: 5px 20px;
    font-size: 1rem;
    transition: all 0.3s;
}

.btn-setting {
    background-color: white;
    color: black !important;
    border-radius: 100px;
    padding: 5px 20px;
    border: none;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
}

.btn-info {
    background-color: white;
    color: black !important;
    border: none;
    border-radius: 100px;
    padding: 5px 20px;
    font-size: 1rem;
    transition: all 0.3s;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
}
/* dropdown menu */
.dd-menu .dropdown-menu{
  width: 200px; /* Restricts the menu width */
}

.dd-menu .dropdown-menu.show{
  display: block;
  overflow: hidden;
  text-overflow: ellipsis; /* Adds "..." for long text */
  width: 300px;
}

/* Make dropdown menu width match button */
.dropdown-toggle {
  position: relative;
}

.dropdown-toggle ~ .dropdown-menu {
  width: auto;
  min-width: 300px;
  text-align: center;
}