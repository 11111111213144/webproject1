    <main>
        <h1>เพิ่มรายการวัสดุ</h1>
        <div class="form-box">
            <form action="">

                <label for="itemname">ชื่อวัสดุ :</label>
                <input type="text" id="itemname" name="itemname"><br><br>
                
                <select name="type" >
                    <option >วัสดุ</option>
                    <option>ครุภัณฑ์</option>
                    <option>เวชภัณฑ์</option>
                </select>
                <br><br >

                <label for="price">ราคา :</label>
                <input type="text" id="price" name="price"><br><br>

                <label for="unit">หน่วยนับ :</label>
                <input type="text" id="unit" name="unit"><br><br>

                <label for="remain">จำนวนคงเหลือ :</label>
                <input type="text" id="remain" name="remain"><br><br>   

                <label for="company">บริษัท/ร้านค้า :</label>
                <input type="text" id="company" name="company"><br><br>

                <button type="submit" class="submit-btn">บันทึก</button>
            </form>
        </div>
    </main>
