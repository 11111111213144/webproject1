<!DOCTYPE html>
<html lang="th">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ระบบการจัดซื้อจัดจ้าง</title>

    <link rel="stylesheet" href="css/new_style.css">
</head>

<body>
    <header>
        <%- include('navbar')%>
    </header>

    <main>
        <h1>ภาพรวม</h1>
        <div class="main-card">

            <div class="card">
                <div class="card-inner">
                    <span class="material-symbols-outlined">box</span>
                    <p class="text-primary">พัสดุ</p>
                </div>
                <p>
                    <%= amt_item%>
                </p>
            </div>
            <div class="card">
                <div class="card-inner">
                    <span class="material-symbols-outlined">
                        money_bag
                    </span>
                    <p class="text-primary">ราคารวม</p>

                </div>
                <p>
                    <%= Number(total_money).toLocaleString('th-TH') %>
                </p>
            </div>
            <div class="card">
                <div class="card-inner">
                    <span class="material-symbols-outlined">
                        assignment
                    </span>
                    <p class="text-primary">แผนจัดซื้อ</p>
                </div>
                <p>
                    <%= total_plan%>
                </p>
            </div>
            <div class="card">
                <div class="card-inner">
                    <span class="material-symbols-outlined">
                        receipt_long
                    </span>
                    <p class="text-primary">ใบสั่งซื้อ</p>
                </div>
                <p class="value">
                    <%= total_po %>
                </p>
            </div>
        </div>
        <div class="main-box">
            <div class="box">
                <h1>5 ใบสั่งซื้อที่รอการอนุมัติ</h1>

                <table class="table-box">
                    <thead>
                        <tr>
                            <th>ลำดับที่</th>
                            <th>เลขที่ใบสั่งซื้อ</th>
                            <th>บริษัท/ร้านค้า</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% for(let i=0; i < 5; i++) { %>
                            <% if(plan && plan[i]) { %>
                                <tr>
                                    <td>
                                        <%= i + 1 %>
                                    </td>
                                    <td>
                                        <%= plan[i].plan_Id %>
                                    </td>
                                    <td>
                                        <%= plan[i].plan_name %>
                                    </td>
                                </tr>
                                <% } else { %>
                                    <tr>
                                        <td>
                                            <%= i + 1 %>
                                        </td>
                                        <td>-</td>
                                        <td>-</td>
                                    </tr>
                                    <% } %>
                                        <% } %>
                    </tbody>

                </table>
            </div>


            <div class="box">
                <h1>5 ใบสั่งซื้อที่รอการอนุมัติ</h1>

                <table class="table-box">
                    <thead>
                        <tr>
                            <th>ลำดับที่</th>
                            <th>เลขที่ใบสั่งซื้อ</th>
                            <th>บริษัท/ร้านค้า</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% for(let i=0; i < 5; i++) { %>
                            <% if(plan && plan[i]) { %>
                                <tr>
                                    <td>
                                        <%= i + 1 %>
                                    </td>
                                    <td>
                                        <%= plan[i].plan_Id %>
                                    </td>
                                    <td>
                                        <%= plan[i].plan_name %>
                                    </td>
                                </tr>
                                <% } else { %>
                                    <tr>
                                        <td>
                                            <%= i + 1 %>
                                        </td>
                                        <td>-</td>
                                        <td>-</td>
                                    </tr>
                                    <% } %>
                                        <% } %>
                    </tbody>

                </table>
            </div>
        </div>
    </main>

    <div class="grid-container"></div>
    <footer></footer>
    <script src="css/scripts.js"></script>
</body>