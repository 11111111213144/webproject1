<!DOCTYPE html>
<html lang="th">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ระบบการจัดซื้อจัดจ้าง</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="../css/style.css">
    <link rel="stylesheet" href="../css/delbtn.css">
</head>

<body>
    <nav class="navbar navbar-expand-lg bg-custom-mint">
        <div class="container-fluid">
            <a class="navbar-brand ps-3" href="/homepage">home</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav mx-auto center-menu">
                    <li class="nav-item"><a class="nav-link" href="/checkorder">ตรวจสอบรายการ</a></li>
                    <li class="nav-item"><a class="nav-link" href="/createplan">ทำแผนจัดซื้อ</a></li>
                    <li class="nav-item"><a class="nav-link" href="/makeplan">ทำใบสั่งซื้อ</a></li>
                </ul>
                <ul class="navbar-nav">
                    <li class="nav-item pe-3"><a class="nav-link bth-logout" href="/login">ออกจากระบบ</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container text-left mb-4">
        <button type="button" class="welcome-text btn-setting btn-secondary btn-lg dropdown-toggle" data-bs-toggle="dropdown">ทำแผนจัดซื้อรายปี</button>
        <ul class="dd-menu dropdown-menu">
            <li><a class="dd-menu dropdown-item" href="/createplan">รายปี</a></li>
            <li><a class="dd-menu dropdown-item" href="/createplan/mouth">รายเดือน</a></li>
            <li><a class="dd-menu dropdown-item" href="/createplan/outplan">นอกแผน</a></li>
        </ul>
    </div>

    <div class="container mb-3">
        <div class="row flex-column flex-lg-row">
            <div class="col-12 col-lg-auto mb-2 mb-lg-0">
                <button type="button" id="dropdownYearBtn" class="btn-setting btn-primary dropdown-toggle w-100 w-lg-auto" data-bs-toggle="dropdown">เลือกปี</button>
                <ul class="dropdown-menu">
                    <li><a class="dropdown-item" href="#" onclick="filterYear('2568')">2568</a></li>
                    <li><a class="dropdown-item" href="#" onclick="filterYear('2567')">2567</a></li>
                    <li><a class="dropdown-item" href="#" onclick="filterYear('2566')">2566</a></li>
                    <li><hr class="dropdown-divider"></li>
                    <li><a class="dropdown-item" href="#" onclick="filterYear('all')">ดูทั้งหมด</a></li>
                </ul>
            </div>
            <div class="col-12 col-lg-auto ms-lg-auto">
                <div class="d-flex flex-column flex-lg-row gap-2 justify-content-end">
                    
                    <div id="default-buttons" class="d-flex gap-2">
                        <button type="button" class="btn-setting btn-primary" onclick="openPlanModal()">เพิ่มรายการ</button>
                        <button type="button" class="btn-setting btn-primary" onclick="toggleDeleteMode(true)">ลบรายการ</button>
                    </div>

                    <div id="delete-buttons" class="d-none align-items-center gap-2">
                        <span class="me-2" id="selected-count">เลือก 0 รายการ</span>
                        <button type="button" class="btn-setting" onclick="toggleDeleteMode(false)">ยกเลิก</button>
                        <button type="button" class="btn-setting" onclick="confirmDelete()">ยืนยันการลบ</button>
                    </div>

                </div>
            </div>
        </div>
    </div>

    <div class="container text-center mb-5">
        <table class="table table-striped table-hover" id="mainTable">
            <thead class="table-white">
                <tr>
                    <th scope="col" class="checkbox-col">
                        <input type="checkbox" class="form-check-input" onchange="toggleAll(this)">
                    </th>
                    <th scope="col">ลำดับ</th>
                    <th scope="col">ปี</th>
                    <th scope="col">ประเภท</th>
                    <th scope="col"></th>
                </tr>
            </thead>
            <tbody id="materialTableBody">
                <tr>
                    <td class="checkbox-col">
                        <input type="checkbox" class="delete-checkbox form-check-input">
                    </td>
                    <th scope="row">1</th>
                    <td>2566</td> <td>วัสดุก่อสร้าง </td>
                    <td><button type="button" class="btn-info" data-bs-toggle="modal" data-bs-target="#detailsModal" onclick="showDetails(0)">รายละเอียด</button></td>
                </tr>

                
            </tbody>
        </table>
    </div>

    <div class="modal fade" id="planModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">การทำแผน</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">ประเภทแผน</label>
                        <select class="form-select" id="selPlan">
                            <option>รายปี</option>
                            <option>รายเดือน</option>
                            <option>นอกแผน</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">ปี (พุทธศักราช)</label>
                        <div class="d-flex gap-2 date-input-group">
                            <input type="text" class="form-control year" id="inYear" placeholder="ปี พ.ศ." maxlength="4">
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">ประเภทวัสดุ</label>
                        <select class="form-select" id="selMat">
                            <option>วัสดุสำนักงาน</option>
                            <option>วัสดุคอมพิวเตอร์</option>
                            <option>วัสดุไฟฟ้า</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary w-100" onclick="goToItems()">เลือกรายการถัดไป</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="itemModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">เพิ่มข้อมูลรายการ</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-2 mb-3 align-items-end">
                        <div class="col-md-5">
                            <label class="small">ชื่อรายการ</label>
                            <input type="text" class="form-control" id="addItemName">
                        </div>
                        <div class="col-md-2">
                            <label class="small">จำนวน</label>
                            <input type="number" class="form-control" id="addItemQty" value="1" oninput="autoSum()">
                        </div>
                        <div class="col-md-2">
                            <label class="small">ราคา/หน่วย</label>
                            <input type="number" class="form-control" id="addItemPrice" oninput="autoSum()">
                        </div>
                        <div class="col-md-2">
                            <label class="small">รวมเงิน</label>
                            <input type="text" class="form-control bg-light" id="addItemTotal" readonly>
                        </div>
                        <div class="col-md-1">
                            <button class="btn btn-warning w-100 text-white" onclick="addItemToTemp()">เพิ่ม</button>
                        </div>
                    </div>

                    <table class="table table-bordered text-center" id="tempTable">
                        <thead class="table-light">
                            <tr>
                                <th>ลำดับ</th>
                                <th>รายการ</th>
                                <th>จำนวน</th>
                                <th>ราคา/หน่วย</th>
                                <th>ราคารวม</th>
                                <th>จัดการ</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" onclick="backToPlan()">ย้อนกลับ</button>
                    <button type="button" class="btn btn-success px-5" onclick="confirmToMain()">ตกลงและบันทึก</button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/javaSC/btn_create_plan.js"></script>
    <script src="/javaSC/deletebtn.js"></script>


</body>

</html>