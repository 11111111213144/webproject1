<!DOCTYPE html>
<html lang="th">

<head>
    <meta charset="UTF-8">
    <title>แก้ไขข้อมูลสินค้า</title>
    <link rel="stylesheet" href="css/new_style.css">
     <script>
        <% if (locals.msg) { %>
            alert("<%= msg %>");
            <% } %>
    </script>

</head>
<body>
    <header>
    </header>
    <main class="item-edit-container">
        <div class="form-box edit-box">
            <form action="/edititem" method="post">
                <input type="hidden" name="item_Id"
                    value="<%= (locals.inventory && inventory.item_Id) ? inventory.item_Id : '' %>">

                <label for="item_name">ชื่อวัสดุ :</label>
                <input type="text" id="item_name" name="item_name"
                    value="<%= (locals.inventory && inventory.item_name) ? inventory.item_name : '' %>"><br><br>

                <label for="item_type">ประเภท :</label>
                <select class="add-btn" name="item_type">
                    <option value="วัสดุ" <%=(locals.inventory && inventory.item_type=='วัสดุ' ) ? 'selected' : '' %>
                        >วัสดุ</option>
                    <option value="ครุภัณฑ์" <%=(locals.inventory && inventory.item_type=='ครุภัณฑ์' ) ? 'selected' : ''
                        %>>ครุภัณฑ์</option>
                    <option value="เวชภัณฑ์" <%=(locals.inventory && inventory.item_type=='เวชภัณฑ์' ) ? 'selected' : ''
                        %>>เวชภัณฑ์</option>
                </select>

                <label for="unit_price">ราคา :</label>
                <input type="text" id="unit_price" name="unit_price"
                    value="<%= (locals.inventory && inventory.unit_price) ? inventory.unit_price : '' %>"><br><br>

                <label for="unit">หน่วยนับ :</label>
                <input type="text" id="unit" name="unit"
                    value="<%= (locals.inventory && inventory.unit) ? inventory.unit : '' %>"><br><br>

                <label for="remain">จำนวนคงเหลือ :</label>
                <input type="text" id="remain" name="remain"
                    value="<%= (locals.inventory && inventory.remain) ? inventory.remain : '' %>"><br><br>

                <label for="Company_shop">บริษัท/ร้านค้า :</label>
                <input type="text" id="Company_shop" name="Company_shop"
                    value="<%= (locals.inventory && inventory.Company_shop) ? inventory.Company_shop : '' %>"><br><br>

                <button type="submit" class="submit-btn">บันทึก</button>

            </form>
        </div>
        <footer>
            <button type="submit" class="submit-btn">ย้อนกลับ</button>
        </footer>
    </main>

    <footer>
        <button type="submit" class="submit-btn" onclick="history.back()">ย้อนกลับ</button>
    </footer>


</body>

</html>