<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ระบบการจัดซื้อจัดจ้าง</title>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="../css/style.css">

    <style>
        .form-control {
            border: 1px solid #000000 !important;
            border-radius: 4px;
        }

        .btn-save-custom {
            background-color: #198754;
            color: white;
            border: none;
            padding: 8px 16px;
            border-radius: 6px;
        }

        .btn-cancel-custom {
            background-color: #6c757d;
            color: white;
            border: none;
            padding: 8px 16px;
            border-radius: 6px;
        }

        /* --- แก้ไข 1: เปลี่ยนมาใช้ display: none เพื่อซ่อนคอลัมน์แบบสมบูรณ์ --- */
        .checkbox-col {
            display: none; /* ซ่อนพื้นที่และการคำนวณเส้นขอบทั้งหมด */
        }
        
        .checkbox-col.active {
            display: table-cell; /* แสดงผลเมื่อกดปุ่มลบ */
            width: 50px;
            padding: 8px !important;
            border-bottom: 1px solid #dee2e6;
            vertical-align: middle;
            text-align: center;
        }

        /* --- แก้ไข 2: สร้างเส้นแบ่งตาราง (Divider) ที่หัวตารางแทน --- */
        thead.table-white {
            border-bottom: 2px solid #000 !important; /* เส้นสีดำหนา แบ่งหัวกับตัว */
        }

        tr:hover { background-color: #f8f9fa; cursor: pointer; }
    </style>
</head>
<body>
 
    <nav class="navbar navbar-expand-lg bg-custom-mint">
        <div class="container-fluid">
            <a class="navbar-brand ps-3" href="/homepage">home</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav mx-auto center-menu">
                    <li class="nav-item"><a class="nav-link" href="/checkorder">ตรวจสอบรายการ</a></li>
                    <li class="nav-item"><a class="nav-link" href="/createplan">ทำแผนจัดซื้อ</a></li>
                    <li class="nav-item"><a class="nav-link" href="/makeplan">ทำใบสั่งซื้อ</a></li>
                </ul>
                <ul class="navbar-nav">
                    <li class="nav-item pe-3"><a class="nav-link bth-logout" href="/login">ออกจากระบบ</a></li>
                </ul>
            </div>
        </div>
    </nav>
 
    <div class="container text-left">
        <h1 class="welcome-text">รายการวัสดุ</h1>
    </div>
 
    <div class="container mb-3">
        <div class="row flex-column flex-lg-row">
            <div class="col-12 col-lg-auto ms-lg-auto">
                <div class="d-flex flex-column flex-lg-row gap-2 justify-content-end">
                    
                    <div id="default-buttons" class="d-flex gap-2">
                        <button type="button" class="btn-setting btn-primary" data-bs-toggle="modal" data-bs-target="#addItemModal">เพิ่มรายการ</button>
                        <button type="button" class="btn-setting btn-primary" onclick="toggleDeleteMode(true)">ลบรายการ</button>
                    </div>

                    <div id="delete-buttons" class="d-none align-items-center gap-2">
                        <span class="me-2" id="selected-count">เลือก 0 รายการ</span>
                        <button type="button" class="btn-setting" onclick="toggleDeleteMode(false)">ยกเลิก</button>
                        <button type="button" class="btn-setting" onclick="confirmDelete()">ยืนยันการลบ</button>
                    </div>

                </div>
            </div>
        </div>
    </div>
    
    <div class="container text-center mb-5">
        <table class="table table-striped table-hover">
            <thead class="table-white">
                <tr>
                    <th scope="col" class="checkbox-col">
                        <input type="checkbox" class="form-check-input" onchange="toggleAll(this)">
                    </th>
                    <th scope="col">ลำดับ</th>
                    <th scope="col">รายการ</th>
                    <th scope="col">วัสดุคงเหลือ</th>
                    <th scope="col">ราคา</th>
                    <th scope="col">หน่วยนับ</th>
                    <th scope="col">ราคารวม</th>
                </tr>
            </thead>
            <tbody id="materialTableBody">
                <tr>
                    <td class="checkbox-col">
                        <input type="checkbox" class="delete-checkbox form-check-input">
                    </td>
                    <th scope="row">1</th>
                    <td>กระดาษ A4</td>
                    <td>500</td>
                    <td>200</td>
                    <td>รีม</td>
                    <td>100,000</td>
                </tr>
                <tr>
                    <td class="checkbox-col">
                        <input type="checkbox" class="delete-checkbox form-check-input">
                    </td>
                    <th scope="row">2</th>
                    <td>ปากกาเจล</td>
                    <td>300</td>
                    <td>50</td>
                    <td>ด้าม</td>
                    <td>15,000</td>
                </tr>
                <tr>
                    <td class="checkbox-col">
                        <input type="checkbox" class="delete-checkbox form-check-input">
                    </td>
                    <th scope="row">3</th>
                    <td>แฟ้มเอกสาร</td>
                    <td>150</td>
                    <td>80</td>
                    <td>เล่ม</td>
                    <td>12,000</td>
                </tr>
            </tbody>
        </table>
    </div>

    <div class="modal fade" id="addItemModal" tabindex="-1" aria-labelledby="addItemModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header border-0">
                    <h5 class="modal-title" id="addItemModalLabel"><b>เพิ่มข้อมูลรายการวัสดุ</b></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body text-start">
                    <form id="materialForm">
                        <div class="mb-3">
                            <label class="form-label"><b>ชื่อรายการ</b></label>
                            <input type="text" class="form-control" id="itemName" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label"><b>วัสดุคงเหลือ (จำนวน)</b></label>
                            <input type="number" class="form-control" id="itemStock" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label"><b>ราคาต่อหน่วย</b></label>
                            <input type="number" class="form-control" id="itemPrice" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label"><b>หน่วยนับ</b></label>
                            <input type="text" class="form-control" id="itemUnit" placeholder="เช่น รีม, อัน, แท่ง" required>
                        </div>
                    </form>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn-cancel-custom" data-bs-dismiss="modal">ยกเลิก</button>
                    <button type="button" class="btn-save-custom" onclick="saveNewItem()">บันทึกข้อมูล</button>
                </div>
            </div>
        </div>
    </div>
 
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        
        function saveNewItem() {
            const name = document.getElementById('itemName').value;
            const stock = document.getElementById('itemStock').value;
            const price = document.getElementById('itemPrice').value;
            const unit = document.getElementById('itemUnit').value;

            if (name && stock && price && unit) {
                const tbody = document.getElementById('materialTableBody');
                const nextNo = tbody.rows.length + 1;
                const total = parseFloat(stock) * parseFloat(price);

                const newRow = `
                    <tr>
                        <td class="checkbox-col ${isDeleteMode ? 'active' : ''}">
                            <input type="checkbox" class="delete-checkbox form-check-input" onchange="updateCount()">
                        </td>
                        <th scope="row">${nextNo}</th>
                        <td>${name}</td>
                        <td>${stock}</td>
                        <td>${price}</td>
                        <td>${unit}</td>
                        <td>${total.toLocaleString()}</td>
                    </tr>
                `;
                
                tbody.insertAdjacentHTML('beforeend', newRow);

                document.getElementById('materialForm').reset();
                const modal = bootstrap.Modal.getInstance(document.getElementById('addItemModal'));
                modal.hide();
            } else {
                alert("กรุณากรอกข้อมูลให้ครบทุกช่อง");
            }
        }

        
    </script>
    <script src="javaSC/deletebtn.js"></script>
</body>
</html>