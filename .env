DB_USER=root                                
DB_HOST=localhost                           
DB_NAME=procurement_management_system       
DB_PASSWORD=1234                            
secret=mysecretkey                          

# # การตั้งค่าการเชื่อมต่อฐานข้อมูล (Database Configuration)
# DB_USER=root                                # ชื่อผู้ใช้ฐานข้อมูล (ตัวอย่าง: root)
# DB_HOST=localhost                           # ที่อยู่ของ Database Server (เช่น localhost หรือ IP Address)
# DB_NAME=procurement_management_system       # ชื่อฐานข้อมูลที่คุณสร้างไว้ในระบบ
# DB_PASSWORD=your_password_here              # รหัสผ่านฐานข้อมูล (แก้ไขให้ตรงกับเครื่องของคุณ)
                                            
# # การตั้งค่าความปลอดภัย (Security Configuration)
# secret=your_very_secret_key_here            # คีย์ลับสำหรับใช้งาน Token หรือ Session (แนะนำให้ตั้งยาวๆ และยากต่อการเดา)