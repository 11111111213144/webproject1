<!DOCTYPE html>
<html lang="th">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>เพิ่มรายการวัสดุ</title>
    <link rel="stylesheet" href="/css/main.css">
    <link rel="stylesheet" href="/css/navbar.css">
    <link rel="stylesheet" href="/css/forms.css">
    <script>
        <% if (locals.msg) { %>
            alert("<%= msg %>");
            <% } %>
    </script>
</head>

<body>
    <header>
    </header>
    <main>
        <div class="form-box">
            <h1>เพิ่มรายการวัสดุ</h1>
            <form action="/createitem" method="post">
                <div class="form-group">
                    <label for="item_name">ชื่อวัสดุ</label>
                    <input type="text" id="item_name" name="item_name" required>
                </div>
                
                <div class="form-group">
                    <label for="item_type">ประเภท</label>
                    <select id="item_type" name="item_type" required>
                        <option value="">เลือกประเภท</option>
                        <option value="วัสดุ">วัสดุ</option>
                        <option value="ครุภัณฑ์">ครุภัณฑ์</option>
                        <option value="เวชภัณฑ์">เวชภัณฑ์</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="unit_price">ราคา</label>
                    <input type="number" id="unit_price" name="unit_price" step="0.01" min="0" required>
                </div>

                <div class="form-group">
                    <label for="unit">หน่วยนับ</label>
                    <input type="text" id="unit" name="unit" required>
                </div>

                <div class="form-group">
                    <label for="remain">จำนวนคงเหลือ</label>
                    <input type="number" id="remain" name="remain" min="0" required>
                </div>

                <div class="form-group">
                    <label for="Company_shop">บริษัท/ร้านค้า</label>
                    <input type="text" id="Company_shop" name="Company_shop" required>
                </div>

                <div class="form-actions">
                    <button type="submit" class="submit-btn">บันทึก</button>
                    <button type="button" class="submit-btn" onclick="history.back()" style="background: linear-gradient(135deg, #95a5a6 0%, #7f8c8d 100%);">ย้อนกลับ</button>
                </div>
            </form>
        </div>
    </main>
</body>

</html>