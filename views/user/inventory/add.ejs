<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/css/main.css">
    <link rel="stylesheet" href="/css/navbar.css">
    <link rel="stylesheet" href="/css/forms.css">
    <script>
        <% if (locals.msg) { %>
            alert("<%= msg %>");
            <% } %>
    </script>

</head>

<body>
    <header>
    </header>
    <main>
        <h1>เพิ่มรายการวัสดุ</h1>
        <div class="form-box">
            <form action="/createitem" method="post">

                <label for="item_name">ชื่อวัสดุ :</label>
                <input type="text" id="item_name" name="item_name"><br><br>
                
                <label for="item_type">ประเภท :</label>
                <input type="text" id="item_type" name="item_type"><br><br>

                <label for="unit_price">ราคา :</label>
                <input type="text" id="unit_price" name="unit_price"><br><br>

                <label for="unit">หน่วยนับ :</label>
                <input type="text" id="unit" name="unit"><br><br>

                <label for="remain">จำนวนคงเหลือ :</label>
                <input type="text" id="remain" name="remain"><br><br>

                <label for="Company_shop">บริษัท/ร้านค้า :</label>
                <input type="text" id="Company_shop" name="Company_shop"><br><br>

                <button type="submit" class="submit-btn">บันทึก</button>
            </form>
        </div>
    </main>
    <footer>
        <button type="submit" class="submit-btn" onclick="history.back()">ย้อนกลับ</button>
    </footer>
</body>

</html>