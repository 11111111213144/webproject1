<!DOCTYPE html>
<html lang="th">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>แก้ไขข้อมูลสินค้า</title>
    <link rel="stylesheet" href="/css/main.css">
    <link rel="stylesheet" href="/css/navbar.css">
    <link rel="stylesheet" href="/css/forms.css">
</head>

<body>
    <header>
    </header>
    <main class="item-edit-container">
        <div class="form-box edit-box">
            <h1>แก้ไขข้อมูลสินค้า</h1>
            <form action="/edititem" method="post">
                <input type="hidden" name="item_Id"
                    value="<%= (locals.inventory && inventory.item_Id) ? inventory.item_Id : '' %>">

                <div class="form-group">
                    <label for="item_name">ชื่อวัสดุ</label>
                    <input type="text" id="item_name" name="item_name"
                        value="<%= (locals.inventory && inventory.item_name) ? inventory.item_name : '' %>" required>
                </div>

                <div class="form-group">
                    <label for="item_type">ประเภท</label>
                    <select id="item_type" name="item_type" required>
                        <option value="">เลือกประเภท</option>
                        <option value="วัสดุ" <%=(locals.inventory && inventory.item_type=='วัสดุ' ) ? 'selected' : ''
                            %>>วัสดุ</option>
                        <option value="ครุภัณฑ์" <%=(locals.inventory && inventory.item_type=='ครุภัณฑ์' ) ? 'selected'
                            : '' %>>ครุภัณฑ์</option>
                        <option value="เวชภัณฑ์" <%=(locals.inventory && inventory.item_type=='เวชภัณฑ์' ) ? 'selected'
                            : '' %>>เวชภัณฑ์</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="unit_price">ราคา</label>
                    <input type="number" id="unit_price" name="unit_price" step="0.01" min="0"
                        value="<%= (locals.inventory && inventory.unit_price) ? inventory.unit_price : '' %>" required>
                </div>

                <div class="form-group">
                    <label for="unit">หน่วยนับ</label>
                    <input type="text" id="unit" name="unit"
                        value="<%= (locals.inventory && inventory.unit) ? inventory.unit : '' %>" required>
                </div>

                <div class="form-group">
                    <label for="remain">จำนวนคงเหลือ</label>
                    <input type="number" id="remain" name="remain" min="0"
                        value="<%= (locals.inventory && inventory.remain) ? inventory.remain : '' %>" required>
                </div>
                <div class="form-actions">
                    <button type="submit" class="submit-btn">บันทึกการแก้ไข</button>
                    <button type="button" class="submit-btn" onclick="history.back()"
                        style="background: linear-gradient(135deg, #95a5a6 0%, #7f8c8d 100%);">ย้อนกลับ</button>
                </div>
            </form>
        </div>
    </main>
</body>

</html>