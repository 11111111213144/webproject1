<!DOCTYPE html>
<html lang="th">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>สร้างใบสั่งซื้อ</title>
    <link rel="stylesheet" href="/css/main.css">
    <link rel="stylesheet" href="/css/navbar.css">
    <link rel="stylesheet" href="/css/forms.css">
    <script>
        <% if (locals.msg) { %>
            alert("<%= msg %>");
        <% } %>
    </script>
</head>

<body>
    <header>
        <%- include('../../partials/navbar.ejs') %>
    </header>

    <main>
        <h1>สร้างใบสั่งซื้อ</h1>

        <!-- Form สำหรับสร้าง PO ใหม่ -->
        <form action="/addpo" method="post">

            <label for="po_number">เลขที่ใบสั่งซื้อ :</label>
            <input type="text" name="po_number" required value="PO-"><br><br>

            <label for="supplier_name">บริษัท/ร้านค้า :</label>
            <input type="text" name="supplier_name" required><br><br>

            <label for="po_type">ประเภท :</label>
            <select name="po_type">
                <option value="วัสดุ">วัสดุ</option>
                <option value="ครุภัณฑ์">ครุภัณฑ์</option>
                <option value="เวชภัณฑ์">เวชภัณฑ์</option>
            </select>
            <br><br>

            <label for="po_date">วันที่สั่งซื้อ :</label>
            <input type="date" name="po_date" required>
            <br><br>

            <button type="submit" class="submit-btn">บันทึก</button>
        </form>

        <br>

        <div class="filter-box">
            <button type="button" class="add-btn" onclick="deleteitem()">ลบรายการที่เลือก</button>
        </div>

        <!-- ตารางแสดงรายการ PO -->
        <table class="table-box">
            <thead>
                <tr>
                    <th>ลำดับที่</th>
                    <th>เลขใบสั่งซื้อ</th>
                    <th>บริษัท/ร้านค้า</th>
                    <th>วันที่</th>
                    <th>สถานะ</th>
                    <th>ดูรายละเอียด</th>
                    <th><input type="checkbox" id="selectAll"></th>
                </tr>
            </thead>
            <tbody>
                <% po.forEach((item, index)=> { %>
                    <tr>
                        <td>
                            <%= index + 1 %>
                        </td>
                        <td>
                            <%= item.po_number %>
                        </td>
                        <td>
                            <%= item.supplier_name %>
                        </td>
                        <td>
                            <%= item.po_date %>
                        </td>
                        <td>
                            <%= item.po_status %>
                        </td>
                        <td>
                            <a href="/dash_board_test/po_detail_test/<%= item.po_Id %>"
                                class="btn btn-primary">ดูรายละเอียด</a>
                        </td>
                        <td>
                            <input type="checkbox" class="checkbox" value="<%= item.po_Id %>">
                        </td>
                    </tr>
                    <% }) %>
            </tbody>
        </table>

    </main>

    <script>
            // Select All checkbox
            document.getElementById('selectAll').addEventListener('change', function () {
                const checkboxes = document.querySelectorAll('.checkbox');
                checkboxes.forEach(checkbox => {
                    checkbox.checked = this.checked;
                });
            });

        // Delete selected items
        function deleteitem() {
            const checkboxes = document.querySelectorAll('.checkbox:checked');
            const ids = Array.from(checkboxes).map(cb => cb.value);

            if (ids.length === 0) {
                alert('กรุณาเลือกรายการที่ต้องการลบ');
                return;
            }

            if (!confirm('คุณต้องการลบรายการที่เลือกหรือไม่?')) {
                return;
            }

            fetch('/bth_po/deletepo', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ ids: ids })
            })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        alert('ลบรายการสำเร็จ');
                        window.location.reload();
                    } else {
                        alert('เกิดข้อผิดพลาดในการลบ');
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('เกิดข้อผิดพลาดในการเชื่อมต่อ');
                });
        }
    </script>
</body>

</html>