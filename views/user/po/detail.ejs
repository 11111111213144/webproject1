<!DOCTYPE html>
<html lang="th">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>แก้ไขใบสั่งซื้อ</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/main.css">
    <link rel="stylesheet" href="/css/navbar.css">
    <link rel="stylesheet" href="/css/forms.css">
    <link rel="stylesheet" href="/css/dashboard.css">
    <link rel="stylesheet" href="/css/components.css">
    <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Kanit', sans-serif;
        }
    </style>
</head>

<body>
    <header>
        <%- include('../../partials/navbar.ejs') %>
    </header>
    <main class="container my-5">
        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <h1 class="card-title text-center mb-4">รายงานข้อมูลใบสั่งซื้อ</h1>
                <div class="row text-center">
                    <div class="col-md-4">
                        <strong>เลขที่ใบสั่งซื้อ:</strong>
                        <%= po.po_number %>
                    </div>
                    <div class="col-md-4">
                        <strong>ชื่อผู้ขาย:</strong>
                        <%= po.supplier_name %>
                    </div>
                    <div class="col-md-4">
                        <strong>วันที่:</strong>
                        <%= po.po_date ? new Date(po.po_date).toLocaleDateString('th-TH') : '-' %>
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-body">
                <h2 class="card-title mb-4">สรุปรายงานสินค้าทั้งหมดในระบบ (All PO Summary)</h2>
                <% if (typeof poItems !=='undefined' && poItems.length> 0) { %>
                    <table class="table table-bordered table-hover align-middle">
                        <thead class="table-primary">
                            <tr>
                                <th>เลขที่ PO</th>
                                <th>สินค้า</th>
                                <th>จำนวน</th>
                                <th>ราคาตกลง</th>
                                <th>รวมรายรายการ</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% poItems.forEach(item=> { %>
                                <tr>
                                    <td>
                                        <%= item.po_number %>
                                    </td>
                                    <td>
                                        <%= item.item_name %>
                                    </td>
                                    <td>
                                        <%= item.quantity %>
                                    </td>
                                    <td>
                                        <%= item.agreed_price ? item.agreed_price.toLocaleString() : '0.00' %>
                                    </td>
                                    <td>
                                        <%= item.total_line_price ? item.total_line_price.toLocaleString() : '0.00' %>
                                    </td>
                                </tr>
                                <% }); %>
                        </tbody>
                    </table>
                    <% } else { %>
                        <div class="alert alert-info text-center">ไม่พบข้อมูลสินค้าสรุป</div>
                        <% } %>
            </div>
        </div>

        <div class="text-center mt-4">
            <a href="/makepo" class="btn btn-secondary">กลับหน้าสารบัญใบสั่งซื้อ</a>
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>