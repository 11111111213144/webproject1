<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/css/main.css">
    <link rel="stylesheet" href="/css/navbar.css">
    <link rel="stylesheet" href="/css/forms.css">
</head>

<body>
    <header>
        <%- include('../../partials/navbar.ejs') %>
    </header>

    <main>
        <h1>เพิ่มแผนจัดซื้อ</h1>

        <form action="/addplan" method="post">

            <label for="itemname">ชื่อแผนงาน :</label>
            <input type="text" name="plan_name"><br><br>

            <label for="type">ประเภท :</label>
            <select name="item_plan">
                <option value="วัสดุ">วัสดุ</option>
                <option value="ครุภัณฑ์">ครุภัณฑ์</option>
                <option value="เวชภัณฑ์">เวชภัณฑ์</option>
            </select>
            <br><br>

            <label for="date" min="today">วันที่ :</label>
            <input type="date" name="plan_date">
            <br><br>

            <button type="submit" class="submit-btn">บันทึก</button>
        </form>

        <table class="table-box">

            <thead>
                <tr>
                    <th>ลำดับที่</th>
                    <th>รหัสแผนงาน</th>
                    <th>ชื่อแผนงาน</th>
                    <th>วันที่</th>
                    <th>ประเภท</th>
                    <th>สถานะ</th>
                    <th>ดูรายระเอียด</th>
                    <th><input type="checkbox" id="selectAll"></th>
                </tr>
            </thead>
            <tbody>
                <% plan.forEach((plan, index)=> { %>
                    <tr>
                        <td>
                            <%= index + 1 %>
                        </td>
                        <td>
                            <%= plan.plan_Id %>
                        </td>
                        <td>
                            <%= plan.plan_name %>
                        </td>
                        <td>
                            <%= plan.plan_date %>
                        </td>
                        <td>
                            <%= plan.item_plan || plan.item_type %>
                        </td>
                        <td>
                            <%= plan.plan_status %>
                        </td>
                        <td>
                            <a href="/dash_board_test/plan_detail_test/<%= plan.plan_Id %>"
                                class="btn btn-primary">ดูรายละเอียด</a>
                        </td>
                        <td>
                            <input type="checkbox" class="checkbox" value="<%= plan.plan_Id %>">
                        </td>
                    </tr>
                    <% }) %>
            </tbody>
        </table>

    </main>
    <footer>
        <button type="submit" class="submit-btn" onclick="history.back()">ย้อนกลับ</button>
    </footer>
</body>

</html>