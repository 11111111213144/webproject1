<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="../css/style.css">
    <script>
        <% if (locals.msg) { %>
            alert("<%= msg %>");
            <% } %>
    </script>
</head>

<body>
    <h1 class="text-center mt-4">ทดสอบไม่ใช้ของจริง</h1>
    <div class="container text-center mb-3">
        <div class="text-center mb-4">รายการผู้ใช้ TEST</div>
        <div class="text-center mb-2">
            <form action="/dash_board_test/update_user" method="POST">
                <label for="userId">รหัสผู้ใช้ที่ต้องการแก้ไข :</label>
                <input type="text" id="userId" name="userId"><br><br>
                <label for="Fname">ชื่อ :</label>
                <input type="text" id="Fname" name="Fname"><br><br>
                <label for="Lname">นามสกุล :</label>
                <input type="text" id="Lname" name="Lname"><br><br>
                <label for="userName">ชื่อผู้ใช้ :</label>
                <input type="text" id="userName" name="userName"><br><br>
                <label for="userPass">รหัสผ่าน :</label>
                <input type="text" id="userPass" name="userPass"><br><br>
                <label for="email">อีเมล :</label>
                <input type="email" id="email" name="email"><br><br>
                <label for="phone">เบอร์โทรศัพท์ :</label>
                <input type="text" id="phone" name="phone"><br><br>
                <label for="role">บทบาท :</label>
                <select id="role" name="role">
                    <option value="member" selected>member</option>
                    <option value="admin">admin</option>
                </select><br><br>
                <button type="submit" class="btn btn-primary">บันทึก</button>
            </form>
        </div>
        <div class="text-center mb-2">
            <form action="/dash_board_test/delete_user" method="POST">
                <label for="userId">รหัสผู้ใช้ที่ต้องการลบ :</label>
                <input type="text" id="userId" name="userId"><br><br>
                <button type="submit" class="btn btn-primary">ลบ</button>
            </form>
        </div>
        <table class="table table-bordered table-striped">
            <thead class="table-white">
                <tr>
                    <th>ลำดับ</th>
                    <th>รหัสผู้ใช้</th>
                    <th>ชื่อ</th>
                    <th>นามสกุล</th>
                    <th>ชื่อผู้ใช้</th>
                    <th>รหัสผ่าน</th>
                    <th>อีเมล</th>
                    <th>เบอร์โทรศัพท์</th>
                    <th>บทบาท</th>
                </tr>
            </thead>
            <tbody>
                <% user.forEach((user, index)=> { %>
                    <tr>
                        <td>
                            <%= index + 1 %>
                        </td>
                        <td>
                            <%= user.userId %>
                        </td>
                        <td>
                            <%= user.Fname %>
                        </td>
                        <td>
                            <%= user.Lname %>
                        </td>
                        <td>
                            <%= user.userName %>
                        </td>
                        <td>
                            <%= user.userPass %>
                        </td>
                        <td>
                            <%= user.email %>
                        </td>
                        <td>
                            <%= user.phone %>
                        </td>
                        <td>
                            <%= user.role %>
                        </td>
                    </tr>
                    <% }) %>
            </tbody>
        </table>
    </div>
    <div class="container text-center mb-3">
        <div class="text-center mb-2">
            <div class="text-center mb-4">เพิ่มข้อมูลรายการวัสดุ TEST</div>
            <form action="/dash_board_test/create_item" method="POST">
                <label for="item_name">ชื่อวัสดุ :</label>
                <input type="text" id="item_name" name="item_name"><br><br>
                <label for="item_type">ประเภท :</label>
                <input type="text" id="item_type" name="item_type"><br><br>

                <label for="unit_price">ราคา :</label>
                <input type="text" id="unit_price" name="unit_price"><br><br>

                <label for="unit">หน่วยนับ :</label>
                <input type="text" id="unit" name="unit"><br><br>

                <label for="remain">จำนวนคงเหลือ :</label>
                <input type="text" id="remain" name="remain"><br><br>

                <label for="Company_shop">บริษัท/ร้านค้า :</label>
                <input type="text" id="Company_shop" name="Company_shop"><br><br>

                <button type="submit" class="btn btn-primary">บันทึก</button>
            </form>
        </div>
        <div class="text-center mb-2">
            <div class="text-center mb-4">ลบรายการวัสดุ TEST</div>
            <form action="/dash_board_test/delete_item" method="POST">
                <label for="item_Id">รหัสวัสดุที่ต้องการลบ :</label>
                <input type="text" id="item_Id" name="item_Id"><br><br>
                <button type="submit" class="btn btn-primary">ลบ</button>
            </form>
        </div>
        <div class="text-center mb-4">แก้ไขข้อมูลรายการวัสดุ TEST</div>
        <form action="/dash_board_test/update_item" method="POST">
            <label for="item_Id">รหัสวัสดุที่ต้องการแก้ไข :</label>
            <input type="text" id="item_Id" name="item_Id"><br><br>
            <label for="item_name">ชื่อวัสดุ :</label>
            <input type="text" id="item_name" name="item_name"><br><br>
            <label for="item_type">ประเภท :</label>
            <input type="text" id="item_type" name="item_type"><br><br>

            <label for="unit_price">ราคา :</label>
            <input type="text" id="unit_price" name="unit_price"><br><br>

            <label for="unit">หน่วยนับ :</label>
            <input type="text" id="unit" name="unit"><br><br>

            <label for="remain">จำนวนคงเหลือ :</label>
            <input type="text" id="remain" name="remain"><br><br>

            <label for="Company_shop">บริษัท/ร้านค้า :</label>
            <input type="text" id="Company_shop" name="Company_shop"><br><br>

            <button type="submit" class="btn btn-primary">บันทึก</button>
        </form>
    </div>

    <table class="table table-bordered table-striped">

        <thead class="table-white">
            <tr>
                <th>ลำดับ</th>
                <th>รหัสวัสดุ</th>
                <th>ชื่อวัสดุ</th>
                <th>ประเภทวัสดุ</th>
                <th>วัสดุคงเหลือ</th>
                <th>ราคา</th>
                <th>หน่วยนับ</th>
                <th>บริษัท/ร้านค้า</th>
                <th>ราคารวม</th>
            </tr>
        </thead>
        <tbody>
            <% inventory.forEach((inventory, index)=> { %>
                <tr>
                    <td>
                        <%= index + 1 %>
                    </td>
                    <td>
                        <%= inventory.item_Id %>
                    </td>
                    <td>
                        <%= inventory.item_name %>
                    </td>
                    <td>
                        <%= inventory.item_type %>
                    </td>
                    <td>
                        <%= inventory.remain %>
                    </td>
                    <td>
                        <%= inventory.unit_price %>
                    </td>
                    <td>
                        <%= inventory.unit %>
                    </td>
                    <td>
                        <%= inventory.Company_shop %>
                    </td>
                    <td>
                        <%= inventory.total_price %>
                    </td>
                </tr>
                <% }) %>
        </tbody>
    </table>
    </div>
    <div class="container text-center mb-3">
        <div class="text-center mb-2">
            <div class="text-center mb-4">เพิ่มข้อมูลแผนงาน TEST</div>
            <form action="/dash_board_test/create_plan" method="POST">
                <label for="plan_name">ชื่อแผนงาน :</label>
                <input type="text" id="plan_name" name="plan_name"><br><br>
                <label for="plan_date">วันที่ :</label>
                <input type="date" id="plan_date" name="plan_date"><br><br>
                <label for="plan_status">สถานะ :</label>
                <input type="hidden" value="รออนุมัติ" id="plan_status" name="plan_status"><br><br>
                <label for="item_plan">ประเภทวัสดุ : </label>
                <select name="item_plan" id="item_plan">
                    <option value="">-- เลือกประเภทวัสดุ --</option>
                    <option value="วัสดุ">วัสดุ</option>
                    <option value="ครุภัณฑ์">ครุภัณฑ์</option>
                    <option value="เวชภัณฑ์">เวชภัณฑ์</option>
                </select><br><br>

                <button type="submit" class="btn btn-primary">บันทึก</button>
            </form>
        </div>

        <div class="text-center mb-2">
            <div class="text-center mb-4">ลบข้อมูลแผนงาน TEST</div>
            <form action="/dash_board_test/delete_plan" method="POST">
                <label for="plan_Id">รหัสแผนงานที่ต้องการลบ :</label>
                <input type="text" id="plan_Id" name="plan_Id"><br><br>
                <button type="submit" class="btn btn-primary">ลบ</button>
            </form>
        </div>
        <div>
            <div class="text-center mb-4">แก้ไขข้อมูลแผนงาน TEST</div>
            <form action="/dash_board_test/update_plan" method="POST">
                <label for="plan_Id">รหัสแผนงานที่ต้องการแก้ไข :</label>
                <input type="text" id="plan_Id" name="plan_Id"><br><br>
                <label for="plan_status">สถานะ :</label>
                <select id="plan_status" name="plan_status">
                    <option value="">-- เลือกสถานะ --</option>
                    <option value="รออนุมัติ">รออนุมัติ</option>
                    <option value="อนุมัติ">อนุมัติ</option>
                    <option value="ไม่อนุมัติ">ไม่อนุมัติ</option>
                </select>
                <br><br>
                <button type="submit" class="btn btn-primary">บันทึก</button>
            </form>
        </div>

        <table class="table table-bordered table-striped">
            <thead class="table-white">
                <tr>
                    <th>ลำดับ</th>
                    <th>รหัสแผนงาน</th>
                    <th>ชื่อแผนงาน</th>
                    <th>วันที่</th>
                    <th>ประเภท</th>
                    <th>สถานะ</th>
                    <th>รายละเอียด</th>
                </tr>
            </thead>
            <tbody>
                <% plan.forEach((plan, index)=> { %>
                    <tr>
                        <td>
                            <%= index + 1 %>
                        </td>
                        <td>
                            <%= plan.plan_Id %>
                        </td>
                        <td>
                            <%= plan.plan_name %>
                        </td>
                        <td>
                            <%= plan.plan_date %>
                        </td>
                        <td>
                            <%= plan.item_plan || plan.item_type %>
                        </td>
                        <td>
                            <%= plan.plan_status %>
                        </td>
                        <td>
                            <a href="/dash_board_test/views/plan/details/<%= plan.plan_Id %>"
                                class="btn btn-primary">ดูรายละเอียด</a>
                        </td>
                    </tr>
                    <% }) %>
            </tbody>
        </table>
    </div>
    <div class="container text-center mb-3">
        <div class="text-center mb-4">รายการสั่งซื้อ TEST</div>
        <div class="text-center mb-2">
            <form action="/dash_board_test/create_po" method="POST">
                <label for="po_number">เลขที่สั่งซื้อ :</label>
                <input type="text" id="po_number" name="po_number"><br><br>
                <label for="po_date">วันที่สั่งซื้อ :</label>
                <input type="date" id="po_date" name="po_date"><br><br>
                <label for="po_status">สถานะ :</label>
                <select id="po_status" name="po_status">
                    <option value="รอรับของ">รอรับของ</option>
                </select>

                <br><br>
                <label for="po_detail">รายละเอียด :</label>
                <input type="text" id="po_detail" name="po_detail"><br><br>
                <button type="submit" class="btn btn-primary">บันทึก</button>
            </form>
        </div>
        <div class="text-center mb-2">
            <form action="/dash_board_test/delete_po" method="POST">
                <label for="po_number">เลขที่สั่งซื้อที่ต้องการลบ :</label>
                <input type="text" id="po_number" name="po_number"><br><br>
                <button type="submit" class="btn btn-primary">ลบ</button>
            </form>
        </div>
        <div class="text-center mb-2">
            <form action="/dash_board_test/update_po" method="POST">
                <label for="po_number">เลขที่สั่งซื้อที่ต้องการแก้ไข :</label>
                <input type="text" id="po_number" name="po_number"><br><br>
                <label for="po_status">สถานะ : </label>
                <select id="po_status" name="po_status">
                    <option value="รอรับของ">รอรับของ</option>
                    <option value="รับของแล้ว">รับของแล้ว</option>
                </select>
                <br><br>
                <button type="submit" class="btn btn-primary">บันทึก</button>
            </form>
        </div>
        <table class="table table-bordered table-striped">
            <thead class="table-white">
                <tr>
                    <th>ลำดับ</th>
                    <th>เลขที่สั่งซื้อ</th>
                    <th>ร้านค้า</th>
                    <th>วันที่สั่งซื้อ</th>
                    <th>สถานะ</th>
                    <th>รายละเอียด</th>
                </tr>
            </thead>
            <tbody>
                <% order.forEach((po, index)=> { %>
                    <tr>
                        <td>
                            <%= index + 1 %>
                        </td>
                        <td>
                            <%= po.po_number %>
                        </td>
                        <td>
                            <%= po.supplier_name %>
                        </td>
                        <td>
                            <%= po.po_date %>
                        </td>
                        <td>
                            <%= po.po_status %>
                        </td>
                        <td>
                            <a href="/dash_board_test/views/plan/po/detail/<%= po.po_Id %>"
                                class="btn btn-primary">ดูรายละเอียด</a>
                        </td>
                    </tr>
                    <% }) %>
            </tbody>
        </table>

    </div>
</body>

</html>